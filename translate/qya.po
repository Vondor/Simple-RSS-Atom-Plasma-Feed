#~ msgstr "Lá quanta ná, nómë hehtaina nauva…"

#~ msgid "Add feed URL..."
#~ msgstr "Á napanë ehtelëo nómë…"

#~ msgid "Blacklist (Regex):"
#~ msgstr "Hehtainë quettar (Regex):"

#~ msgid "No exclusion patterns configured."
#~ msgstr "Lá ëar tengwi."

#~ msgid "Add block expression..."
#~ msgstr "Á napanë hehtaina quetta…"

#~ msgid "Regex Filter Articles..."
#~ msgstr "Á cilë sinyar…"


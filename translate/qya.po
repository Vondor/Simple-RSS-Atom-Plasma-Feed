#: contents/config/config.qml
msgid "General"
msgstr "Héra"

#: contents/ui/configGeneral.qml
msgid "Widget Title:"
msgstr "Carmo essë:"

#: contents/ui/configGeneral.qml
msgid "Leave empty to show no title"
msgstr "Á lav lusta, ar essë ua tanina"

#: contents/ui/configGeneral.qml
msgid "Refresh Interval:"
msgstr "Envinyatiéno lúmë:"

#: contents/ui/configGeneral.qml
msgid "RSS Feed Sources:"
msgstr "RSS ehteli:"

#: contents/ui/configGeneral.qml
msgid "Remove Source"
msgstr "Á hehta ehtelë"

#: contents/ui/configGeneral.qml
msgid "No feeds configured yet."
msgstr "Lá ëar ehteli."

#: contents/ui/configGeneral.qml
msgid "Paste a feed address…"
msgstr "Á panya ehtelëo tengwa…"

#: contents/ui/configGeneral.qml
msgid "Add"
msgstr "Á napanë"

#: contents/ui/configGeneral.qml
msgid "This feed is already in the list."
msgstr "Ehtelë sina ëa yando i combessë."

#: contents/ui/configGeneral.qml
msgid "This is not a web address. A feed address looks like https://example.org/feed."
msgstr "Si ua tengwa natsessë. Ehtelëo tengwa ná ve https://example.org/feed."

#: contents/ui/configGeneral.qml
msgid "Hide Articles Matching:"
msgstr "Á nurta sinyar arwa:"

#: contents/ui/configGeneral.qml
msgid "Remove Pattern"
msgstr "Á hehta tengwë"

#: contents/ui/configGeneral.qml
msgid "No articles are hidden."
msgstr "Ua ëar nurtainë sinyar."

#: contents/ui/configGeneral.qml
msgid "Add a word…"
msgstr "Á napanë quetta…"

#: contents/ui/configGeneral.qml
msgid "Articles whose title or source contains one of these words are hidden. Upper and lower case do not matter. Regular expressions work too."
msgstr "Sinyar yaiva essë hya ehtelë samë quetta sine nar nurtainë. Tengwi alte hya pityë ua valir. Tengwi Regex mahtar yando."

#: contents/ui/main.qml
msgid "Never"
msgstr "Ullumë"

#: contents/ui/main.qml
msgid "Search articles…"
msgstr "Á cesta sinyar…"

#: contents/ui/main.qml
msgid "Clear search"
msgstr ""

#: contents/ui/main.qml
msgid "Last Updated: %1"
msgstr "Métima envinyatië: %1"

#: contents/ui/main.qml
msgid "No feed could be loaded. Showing articles from %1."
msgstr "Ua ehtelë polë cólienna. Tanin sinyar ho %1."

#: contents/ui/main.qml
msgid "No feed could be loaded."
msgstr "Ua ehtelë polë cólienna."

#: contents/ui/main.qml
msgid "Check the address in the settings, or wait for the next update."
msgstr "Á tirë i tengwa mi i panyaler, hya á hópa i hilyala envinyatien."

#: contents/ui/main.qml
msgid "%1 of %2 feeds could not be loaded."
msgid_plural "%1 of %2 feeds could not be loaded."
msgstr[0] "%1 ho %2 ehteli ua polë cólienna."
msgstr[1] "%1 ho %2 ehteler uar polir cólienna."

#: contents/ui/main.qml
msgid "No articles match your search."
msgstr "Lá ëar sinyar ve cestalya."

#: contents/ui/main.qml
msgid "No articles to show. Check your feed sources or your connection."
msgstr "Lá ëar sinyar tanien. Á tirë ehtelelyar hya yanwelya."

#: contents/ui/main.qml
msgid "Config Access Error"
msgstr "Panyaron loima"

#: contents/ui/main.qml
msgid "No sources configured"
msgstr "Lá ëar ehteli"

#: contents/ui/main.qml
msgid "JSON Parse Error"
msgstr "JSON loima"

#: contents/ui/main.qml
msgid "%1: no answer within 15 seconds"
msgstr "%1: ua hanquenta mí lepenquean lúmissi"

#: contents/ui/main.qml
msgid "No Title"
msgstr "Ú essëo"

#: contents/ui/main.qml
msgid "%1: this address is not an RSS or Atom feed"
msgstr "%1: tengwa sina ua ehtelë RSS hya Atom"

#: contents/ui/main.qml
msgid "%1: could not connect"
msgstr "%1: ua polë yanwë"

#: contents/ui/main.qml
msgid "%1: the server answered with error %2"
msgstr "%1: i núro hanquentë loima %2"

#. i18n: Widget name, shown in the "Add Widgets" browser and the KDE Store.
#: translate/metadata-strings.h
msgctxt "@title widget name"
msgid "RSS Feed Plasmoid"
msgstr "RSS Cendalë"

#. i18n: Short widget description, shown under the name in the widget browser.
#: translate/metadata-strings.h
msgctxt "@info widget description"
msgid "A lightweight RSS Feed reader made via Gemini AI, adjusted with Claude AI and Designed by a Human with Human Translations."
msgstr "RSS sinyaron cendalë, Atanen cantaina. Gemini AI carnë, Claude AI envinyatanë; i quettar Atanion nar."


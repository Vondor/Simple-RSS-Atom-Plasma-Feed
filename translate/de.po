#: contents/config/config.qml
msgid "General"
msgstr "Allgemein"

#: contents/ui/configGeneral.qml
msgid "Widget Title:"
msgstr "Widget-Titel:"

#: contents/ui/configGeneral.qml
msgid "Leave empty to show no title"
msgstr "Leer lassen, um keinen Titel anzuzeigen"

#: contents/ui/configGeneral.qml
msgid "Refresh Interval:"
msgstr "Aktualisierungsintervall:"

#: contents/ui/configGeneral.qml
msgid "RSS Feed Sources:"
msgstr "RSS-Feed-Quellen:"

#: contents/ui/configGeneral.qml
msgid "Remove Source"
msgstr "Quelle entfernen"

#: contents/ui/configGeneral.qml
msgid "No feeds configured yet."
msgstr "Noch keine Feeds eingerichtet."

#: contents/ui/configGeneral.qml
msgid "Paste a feed address…"
msgstr "Feed-Adresse einfügen …"

#: contents/ui/configGeneral.qml
msgid "Add"
msgstr "Hinzufügen"

#: contents/ui/configGeneral.qml
msgid "This feed is already in the list."
msgstr "Dieser Feed ist schon in der Liste."

#: contents/ui/configGeneral.qml
msgid "This is not a web address. A feed address looks like https://example.org/feed."
msgstr "Das ist keine Internetadresse. Eine Feed-Adresse sieht so aus: https://example.org/feed."

#: contents/ui/configGeneral.qml
msgid "Hide Articles Matching:"
msgstr "Artikel ausblenden mit:"

#: contents/ui/configGeneral.qml
msgid "Remove Pattern"
msgstr "Muster entfernen"

#: contents/ui/configGeneral.qml
msgid "No articles are hidden."
msgstr "Es werden keine Artikel ausgeblendet."

#: contents/ui/configGeneral.qml
msgid "Add a word…"
msgstr "Wort hinzufügen …"

#: contents/ui/configGeneral.qml
msgid "Articles whose title or source contains one of these words are hidden. Upper and lower case do not matter. Regular expressions work too."
msgstr "Artikel, deren Titel oder Quelle eines dieser Wörter enthält, werden ausgeblendet. Groß- und Kleinschreibung spielt keine Rolle. Reguläre Ausdrücke funktionieren auch."

#: contents/ui/main.qml
msgid "Never"
msgstr "Nie"

#: contents/ui/main.qml
msgid "Search articles…"
msgstr "Artikel suchen …"

#: contents/ui/main.qml
msgid "Clear search"
msgstr "Suche löschen"

#: contents/ui/main.qml
msgid "Last Updated: %1"
msgstr "Zuletzt aktualisiert: %1"

#: contents/ui/main.qml
msgid "No feed could be loaded. Showing articles from %1."
msgstr "Kein Feed konnte geladen werden. Angezeigt werden die Artikel von %1."

#: contents/ui/main.qml
msgid "No feed could be loaded."
msgstr "Kein Feed konnte geladen werden."

#: contents/ui/main.qml
msgid "Check the address in the settings, or wait for the next update."
msgstr "Prüfe die Adresse in den Einstellungen oder warte auf die nächste Aktualisierung."

#: contents/ui/main.qml
msgid "%1 of %2 feeds could not be loaded."
msgid_plural "%1 of %2 feeds could not be loaded."
msgstr[0] "%1 von %2 Feeds konnte nicht geladen werden."
msgstr[1] "%1 von %2 Feeds konnten nicht geladen werden."

#: contents/ui/main.qml
msgid "No articles match your search."
msgstr "Keine Artikel passen zu deiner Suche."

#: contents/ui/main.qml
msgid "No articles to show. Check your feed sources or your connection."
msgstr "Keine Artikel vorhanden. Überprüfe deine Feed-Quellen oder die Internetverbindung."

#: contents/ui/main.qml
msgid "Config Access Error"
msgstr "Fehler beim Zugriff auf die Einstellungen"

#: contents/ui/main.qml
msgid "No sources configured"
msgstr "Keine Quellen eingerichtet"

#: contents/ui/main.qml
msgid "JSON Parse Error"
msgstr "Fehler beim Auswerten der JSON-Daten"

#: contents/ui/main.qml
msgid "%1: no answer within 15 seconds"
msgstr "%1: keine Antwort innerhalb von 15 Sekunden"

#: contents/ui/main.qml
msgid "No Title"
msgstr "Ohne Titel"

#: contents/ui/main.qml
msgid "%1: this address is not an RSS or Atom feed"
msgstr "%1: diese Adresse ist kein RSS- oder Atom-Feed"

#: contents/ui/main.qml
msgid "%1: could not connect"
msgstr "%1: keine Verbindung möglich"

#: contents/ui/main.qml
msgid "%1: the server answered with error %2"
msgstr "%1: der Server antwortete mit Fehler %2"

#. i18n: Widget name, shown in the "Add Widgets" browser and the KDE Store.
#: translate/metadata-strings.h
msgctxt "@title widget name"
msgid "RSS Feed Plasmoid"
msgstr "RSS Feed Plasmoid"

#. i18n: Short widget description, shown under the name in the widget browser.
#: translate/metadata-strings.h
msgctxt "@info widget description"
msgid "A lightweight RSS Feed reader made via Gemini AI, adjusted with Claude AI and Designed by a Human with Human Translations."
msgstr "Ein schlanker RSS-Feed-Reader, erstellt mit Gemini AI, angepasst mit Claude AI, gestaltet und übersetzt von Menschenhand."


#~ msgstr "botmeH mu'tlhegh yIchel…"

#~ msgid "Regex Filter Articles..."
#~ msgstr "ghItlhmey yIwIv…"

#~ msgid "No articles match your filter."
#~ msgstr "ghItlh rap tu'lu'be'."

